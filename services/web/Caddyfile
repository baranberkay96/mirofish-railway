# MiroFish public edge. Upstream MiroFish has no login, and its API starts LLM and
# Zep Cloud work, so everything except the two health probes requires basic auth.
{
	admin off
	persist_config off
	auto_https off
	servers {
		# Railway's edge terminates TLS and forwards X-Forwarded-* headers.
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:8080} {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}

	# Unauthenticated probes: edge liveness (Railway healthcheck) and backend health.
	handle /healthz {
		respond "ok" 200
	}
	handle /health {
		reverse_proxy {$MIROFISH_BACKEND}
	}

	handle {
		basic_auth bcrypt MiroFish {
			{$BASIC_AUTH_USERNAME} {$BASIC_AUTH_HASH}
		}

		handle /api/* {
			# Browsers resend cached basic-auth credentials; refuse API calls
			# started by other sites so they cannot spend your LLM credits.
			@foreign {
				header Sec-Fetch-Site cross-site
				header Sec-Fetch-Site same-site
			}
			respond @foreign "Cross-site API requests are not allowed" 403

			reverse_proxy {$MIROFISH_BACKEND} {
				# The backend does not use the credentials; keep them at the edge.
				header_up -Authorization
				# Report and console logs can be streamed; pass chunks through.
				flush_interval -1
			}
		}

		handle {
			root * /srv
			encode zstd gzip
			@assets path /assets/*
			header @assets Cache-Control "public, max-age=31536000, immutable"
			# Vue router uses HTML5 history mode: unknown paths get the SPA shell.
			try_files {path} /index.html
			file_server
		}
	}
}
